# Red Bears IDOR demo lab — local config. Copy to lab/.env and edit; never
# commit lab/.env (it is gitignored). All values here are placeholders.
#
# Demo-only bearer tokens. These are NOT secrets — they only authenticate a
# request to a demo persona against this local lab — but keep real values out of
# git and logs anyway. If unset, the app uses obvious dev fallbacks
# (dev-alice-token / dev-bob-token), so the lab runs with no config at all.
ALICE_TEST_TOKEN=dev-alice-token
BOB_TEST_TOKEN=dev-bob-token

# URLs the agent gateway (Emre's track) consumes. The operator chooses which to
# hit; the model never sees these as a tool input. Defaults match run_local.py
# and docker-compose.yml.
# VULNERABLE_URL=http://127.0.0.1:18081
# PATCHED_URL=http://127.0.0.1:18082

# Optional port overrides for run_local.py if 18081/18082 are taken.
# REDBEARS_VULN_PORT=18081
# REDBEARS_PATCHED_PORT=18082
