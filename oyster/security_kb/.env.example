# Security KB — environment variables
# Copy to .env and adjust as needed

# Embedding model (any sentence-transformers model)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ChromaDB collection name
COLLECTION_NAME=security_kb

# Chunking parameters
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Embedding batch size (lower = less RAM)
BATCH_SIZE=64
