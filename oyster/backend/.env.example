# Oyster backend configuration — every value has a sensible default in config.py.
# Copy to .env and override only what you need. Nothing here is required for
# local dev. For a network-reachable deploy, the "Deployment + auth" block
# below IS required — see docs/runbooks/OYSTER_DEPLOY.md.

# ── Deployment + auth ────────────────────────────────────────────────────────
# Explicit decision (2026-07): this deploy is fully public, no login required —
# DISABLE_AUTH=true in production is intentional here, not a misconfiguration
# (config.py's boot guard no longer blocks this combination). Because access
# is unrestricted, the Execution Engine (real tool execution) is OFF — chat/
# RAG/knowledge base are what's public; real network probes are not.
OYSTER_ENVIRONMENT=production
OYSTER_DISABLE_AUTH=true
OYSTER_EXECUTION_ENGINE_ENABLED=false

# The rest of this block is inert while OYSTER_DISABLE_AUTH=true, but left
# configured (not deleted) in case login ever comes back — flip DISABLE_AUTH
# to false and these take effect immediately, no code change needed.
# Same Supabase project already used by the Dolphin/VoiceIQ frontend.
OYSTER_SUPABASE_URL=
# OYSTER_SUPABASE_JWT_SECRET=   # legacy HS256 projects only
OYSTER_SUPABASE_AUD=authenticated
OYSTER_SUPABASE_JWKS_TTL_S=600
OYSTER_ADMIN_EMAILS=admin@example.com

# ── Priority access (sold by VoiceIQ, honoured by the chat queue) ───────────
# Red Orca's paid plans advertise "priority access to Oyster". Oyster cannot see
# VoiceIQ's subscriptions table, so it forwards the caller's own Supabase token
# to VoiceIQ's GET /billing/entitlements and reads `oyster_priority`.
#
# LEAVE THIS EMPTY AND NOTHING CHANGES: no lookup happens, no request is
# delayed, and everyone shares one ordinary FIFO line exactly as before. It is
# only worth setting once /billing/entitlements is deployed AND Oyster runs with
# OYSTER_DISABLE_AUTH=false (under the auth bypass every caller is an operator,
# so priority is uniformly true, i.e. a no-op).
#
# Empty is also how this shipped to production and quietly did nothing for every
# paying customer — so set it. Prefer the IN-CLUSTER service name over the public
# domain: both containers sit on compose's default network and resolve each other
# by service name, whereas https://api.redorca.tech leaves the box for public DNS
# and a TLS handshake, inside a 1.5s budget that sits in front of a chat request.
OYSTER_BILLING_API_URL=http://backend:8001
# Short on purpose — this sits in front of a chat request.
# OYSTER_BILLING_TIMEOUT_S=1.5
# A plan does not change between two messages.
# OYSTER_BILLING_CACHE_TTL_S=300
# After ANY failure we stop asking for this long, so a billing outage cannot
# charge every chat request a timeout. Failure always means "not priority".
# OYSTER_BILLING_FAILURE_COOLOFF_S=60
# OYSTER_BILLING_CACHE_MAX=2000
# Anti-starvation bound: a paid job may overtake an ordinary one only during
# that job's first N seconds of waiting. After N it can never be overtaken
# again, which is what stops free users being passed forever under paid load.
# 0 disables overtaking entirely (the kill-switch).
# OYSTER_CHAT_PRIORITY_MAX_OVERTAKE_S=60

# ── Ollama ─────────────────────────────────────────────────────────────────
OLLAMA_HOST=localhost
OLLAMA_PORT=11434
# OLLAMA_BASE_URL=http://localhost:11434   # overrides HOST/PORT if set
# Local Oyster development: OLLAMA_HOST=127.0.0.1, OLLAMA_PORT=11435
OYSTER_DEFAULT_MODEL=oyster-edge-v1-q4
OYSTER_PUBLIC_CHAT_MODEL=oyster-edge-v1-q4
OYSTER_OLLAMA_NUM_CTX=2048
OYSTER_OLLAMA_NUM_BATCH=64
OYSTER_OLLAMA_THINKING_MODEL_PREFIXES=oyster,qwen3,deepseek-r1
#
# The second node. Set this and generation prefers OLLAMA_BASE_URL, falling
# back here whenever that machine is unreachable — which is what lets the
# primary be something that legitimately sleeps (a desktop over Tailscale)
# without Oyster going down with it. Empty = single endpoint, no failover.
#
# BOTH of these are read by docker-compose, so on the VPS they belong in the
# COMPOSE-level env file (/root/voiceiq/.env, beside docker-compose.yml), NOT
# in this file: the compose `environment:` block overrides `env_file:`, so a
# value set here is read and then discarded, and the primary is silently never
# used. Documented here because this is where people look for it.
# OLLAMA_FALLBACK_BASE_URL=http://host.docker.internal:11434

# Failover and timeouts (services/ollama_service.py, services/ollama_probe.py).
# A background task probes every endpoint; requests never pay to discover a
# dead node. Defaults shown; all optional.
# OYSTER_OLLAMA_RETRY_PRIMARY_AFTER_S=30    # cool-off used only before the prober's first round
# OYSTER_OLLAMA_PROBE_INTERVAL_S=15         # probe every endpoint this often
# OYSTER_OLLAMA_PROBE_DOWN_INTERVAL_S=60    # re-probe a DOWN endpoint this often
# OYSTER_OLLAMA_PROBE_CONNECT_S=2           # probe connect/read timeout
# OYSTER_OLLAMA_PROBE_FAILS_TO_DOWN=2       # consecutive probe failures before "down"
# OYSTER_OLLAMA_CONNECT_TIMEOUT_S=3         # connect timeout inside a request
# OYSTER_OLLAMA_READ_TIMEOUT_S=180          # longest silence between streamed chunks
# OYSTER_OLLAMA_GENERATE_TIMEOUT_S=600      # ceiling on a non-streaming (RAG) generation
# OYSTER_OLLAMA_PINNED_MODELS=llama3.2:3b,dolphin3   # kept resident; default = public + default model
# OYSTER_OLLAMA_THINK=false                 # thinking-capable models answer directly
# OYSTER_OLLAMA_THINKING_MODEL_PREFIXES=qwen3,deepseek-r1
# OYSTER_HEALTH_CACHE_S=10                  # /health boot-probe cache before the first round
# OYSTER_CHAT_JOB_MAX_RUNTIME_S=600         # wall clock on one generation
# OYSTER_CHAT_RUNNING_DETACH_GRACE_S=180    # a running job nobody watches is cancelled after this
# OYSTER_CHAT_REAPER_INTERVAL_S=10          # how often the queue reaper wakes

# How many generations run at once, and how many may reach the inference
# server. Defaults: 2, and OLLAMA_MAX_CONCURRENT follows CHAT_MAX_CONCURRENT
# unless set. BOTH must be <= the number of slots the Ollama behind them
# actually serves CONCURRENTLY (its OLLAMA_NUM_PARALLEL). Check the server's
# own log rather than guessing: if every task lands on "slot id 0" and the
# only other line is "all slots are idle", it has exactly one.
#
# Setting these higher than that number does NOT get more throughput — the
# surplus callers stop queueing VISIBLY and instead sit inside Ollama's own
# queue emitting zero bytes until OYSTER_OLLAMA_READ_TIMEOUT_S kills them.
# That is the precise failure services/chat_queue.py exists to prevent
# ("they paid the wait AND got nothing"), and it was live on the VPS on
# 2026-09-14 with these at 4 against a single-slot Ollama.
#
# Raising them is not free: each parallel slot multiplies KV cache per
# loaded model, and on the VPS Ollama runs under MemoryMax=8G with two
# models pinned (deploy/systemd/ollama.service.d/override.conf). Measure
# headroom before increasing either. The VPS runs 1.
# OYSTER_CHAT_MAX_CONCURRENT=2
# OYSTER_OLLAMA_MAX_CONCURRENT=2
#
# Per-NODE overrides. Which machine serves a generation changes at runtime, and
# the two nodes have different slot counts, so a single number is wrong for
# whichever one is not serving. Each defaults to the static value above, so
# setting none of them keeps today's behaviour exactly.
#
# Raise the *_PRIMARY pair only after reading the primary node's real
# OLLAMA_NUM_PARALLEL off that machine's own server log. A Windows node started
# from the tray app rather than its configured service runs Ollama's default of
# ONE slot, and assuming four would reproduce the 2026-09-14 incident there.
# OYSTER_OLLAMA_MAX_CONCURRENT_PRIMARY=4
# OYSTER_OLLAMA_MAX_CONCURRENT_FALLBACK=1
# OYSTER_CHAT_MAX_CONCURRENT_PRIMARY=4
# OYSTER_CHAT_MAX_CONCURRENT_FALLBACK=1
# OYSTER_JWKS_KID_MISS_COOLOFF_S=30         # min seconds between forced JWKS re-fetches

# 2026-09-16, ported from main after diagnosing local response slowness: how
# many generations run at once, and how many may reach the inference server.
# Defaults: 2, and OLLAMA_MAX_CONCURRENT follows CHAT_MAX_CONCURRENT unless
# set. BOTH must be <= the number of slots the Ollama behind them actually
# serves CONCURRENTLY. Check the server's own process, don't guess: on macOS,
# `ps aux | grep llama-server` shows a `-np N` flag -- N is the real slot
# count. This dev machine runs `-np 1`.
#
# Setting these higher than that number does NOT get more throughput — the
# surplus callers stop queueing VISIBLY (in chat_queue.py, with a position
# and ETA) and instead sit inside Ollama's own internal queue emitting zero
# bytes until something else eventually times them out. That is the same
# incident Martin's session found and fixed on the VPS (commit bb3fbe08,
# OYSTER_CHAT_MAX_CONCURRENT was 4 against a single-slot Ollama there).
#
# Per-node overrides (config.effective_chat_concurrent /
# effective_max_concurrent, services/ollama_probe.py) let this be sized
# separately for a faster primary node vs a slower fallback, once the
# background prober is live -- see OYSTER_CHAT_MAX_CONCURRENT_PRIMARY etc.
# below. Until one is set deliberately, behaviour is identical to the plain
# CHAT_MAX_CONCURRENT/OLLAMA_MAX_CONCURRENT values.
# OYSTER_CHAT_MAX_CONCURRENT=1
# OYSTER_OLLAMA_MAX_CONCURRENT=1
# OYSTER_CHAT_MAX_CONCURRENT_PRIMARY=1
# OYSTER_OLLAMA_MAX_CONCURRENT_PRIMARY=1
# OYSTER_CHAT_MAX_CONCURRENT_FALLBACK=1
# OYSTER_OLLAMA_MAX_CONCURRENT_FALLBACK=1

# Background reachability probe (services/ollama_probe.py) and CPU-latency
# knobs. Safe at their defaults; documented here so they're discoverable.
# OYSTER_OLLAMA_PROBE_INTERVAL_S=15
# OYSTER_OLLAMA_PROBE_DOWN_INTERVAL_S=60
# OYSTER_OLLAMA_THINK=false                # true lets thinking-capable models reason before answering (slower TTFT)
# OYSTER_OLLAMA_THINKING_MODEL_PREFIXES=qwen3,deepseek-r1
# OYSTER_HEALTH_CACHE_S=10
# Raw Ollama model names, comma-separated, kept resident (keep_alive -1)
# between requests. Defaults to PUBLIC_CHAT_MODEL + DEFAULT_MODEL -- the two
# that answer nearly every request. Pinning more costs RAM per model's
# weights + KV cache; see OLLAMA_KEEP_ALIVE's comment for what over-pinning
# did to this box once.
# OYSTER_OLLAMA_PINNED_MODELS=dolphin3,llama3.2:3b

# ── Service ports ──────────────────────────────────────────────────────────
OYSTER_BACKEND_PORT=8001
OYSTER_FRONTEND_PORT=3001
# Comma-separated. In production, set to the real frontend origin(s), e.g.
# https://redorca.tech,https://your-oyster-project.vercel.app
# OYSTER_CORS_ORIGINS=http://localhost:3001

# ── Models ─────────────────────────────────────────────────────────────────
OYSTER_DEFAULT_MODEL=dolphin3
OYSTER_REASONING_MODEL=deepseek-r1

# ── Paths (defaults are relative to backend/) ──────────────────────────────
# OYSTER_DATA_DIR=/abs/path/to/data
# OYSTER_LOGS_DIR=/abs/path/to/logs
# OYSTER_VECTOR_DB_DIR=/abs/path/to/data/vector_db
# OYSTER_MEMORY_DB=/abs/path/to/data/memory.db
# OYSTER_SECURITY_KB_DIR=/abs/path/to/security_kb

# ── RAG / embeddings ───────────────────────────────────────────────────────
OYSTER_EMBED_MODEL=all-MiniLM-L6-v2
OYSTER_RAG_COLLECTION=oyster_docs
OYSTER_CHUNK_SIZE=800
OYSTER_CHUNK_OVERLAP=100
OYSTER_MAX_UPLOAD_BYTES=52428800

# ── Media artifacts (image + video — all local) ────────────────────────────
# Vision-language model (Ollama) for image + video-frame understanding.
OYSTER_VISION_MODEL=qwen2.5vl:7b
# OYSTER_VISION_MODEL_FALLBACKS=qwen2.5vl:3b,llava:7b,llava:latest
# OCR: auto (Tesseract if installed, else the VLM reads text) | tesseract | none
OYSTER_OCR_ENGINE=auto
# Local speech transcription (faster-whisper): tiny|base|small|medium
OYSTER_WHISPER_MODEL=base
OYSTER_WHISPER_COMPUTE_TYPE=int8
# Image limits
OYSTER_MAX_IMAGE_SIZE_MB=25
OYSTER_IMAGE_THUMBNAIL_SIZE=512
# Video limits / frame sampling
OYSTER_MAX_VIDEO_SIZE_MB=500
OYSTER_MAX_VIDEO_DURATION_SECONDS=1800
OYSTER_VIDEO_FRAME_INTERVAL_SECONDS=20
OYSTER_VIDEO_MAX_FRAMES=24
OYSTER_VIDEO_PROCESSING_TIMEOUT_SECONDS=1800

# --- Source Connectors (real upstream knowledge ingestion) ------------------
# Transient working dir for shallow clones (cleaned after each import).
OYSTER_KNOWLEDGE_CONNECTOR_WORKDIR=./data/knowledge_src
OYSTER_KNOWLEDGE_CONNECTOR_MAX_FILES=4000
OYSTER_KNOWLEDGE_CONNECTOR_MAX_FILE_BYTES=1048576
OYSTER_KNOWLEDGE_CONNECTOR_MAX_TOTAL_BYTES=64000000
OYSTER_KNOWLEDGE_CONNECTOR_CLONE_TIMEOUT=240
OYSTER_KNOWLEDGE_CONNECTOR_NET_TIMEOUT=30

# --- Operator-responsibility disclaimer footer -----------------------------
# Liability/authorization notice appended to offensive answers (NOT a refusal
# gate — the real boundary is the Execution Engine). Set false to disable.
OYSTER_RESPONSE_DISCLAIMER_ENABLED=true
# OYSTER_RESPONSE_DISCLAIMER_TEXT="<custom footer text>"

# --- User Memory (long-term, per-project, encrypted-at-rest) ----------------
# Fernet key for memory content at rest. If unset, generated on first use and
# persisted (0600) at data/.memory_key — never logged, never sent anywhere.
# OYSTER_MEMORY_ENCRYPTION_KEY=<base64 urlsafe 32-byte key>
OYSTER_USER_MEMORY_COLLECTION=oyster_user_memory
OYSTER_MEMORY_DEDUP_THRESHOLD=0.86
OYSTER_MEMORY_RETRIEVAL_TOP_K=5
# OYSTER_MEMORY_EXTRACTION_MODEL=dolphin3

# --- Dataset RAG (approved, licence-gated datasets — see datasets.json) -----
OYSTER_DATASET_RAG_COLLECTION=oyster_dataset_eval
OYSTER_DATASET_MAX_ROWS=2000
OYSTER_DATASET_HF_PAGE_SIZE=100
OYSTER_DATASET_NET_TIMEOUT=30

# --- Training pipeline (disabled by default, consent-gated LoRA) -----------
# HF/safetensors base model for LoRA (NOT the Ollama GGUF model — see
# CLAUDE.md "Base-model gap"). Requires torch/transformers/peft to actually run.
OYSTER_TRAINING_BASE_MODEL_HF_ID=cognitivecomputations/dolphin-2.9-llama3-8b
OYSTER_TRAINING_MIN_EXAMPLES=20
OYSTER_TRAINING_VAL_SPLIT=0.1
OYSTER_TRAINING_TEST_SPLIT=0.1

# --- MCP gateway (governed Model Context Protocol server) -------------------
# The standards-compliant MCP server that exposes a CURATED, safe subset of
# Oyster's knowledge + governed tools to Claude Code / VS Code (stdio) and a
# future ChatGPT connector (Streamable HTTP). See docs/MCP_GATEWAY.md.
# NEVER put a real secret, token or personal path here — placeholders only.
OYSTER_MCP_ENABLED=true

# stdio identity — WHO the local operator is (audit + which projects resolve).
OYSTER_MCP_LOCAL_EMAIL=dev-local
# OYSTER_MCP_LOCAL_SUB=mcp-local-operator

# HTTP (Streamable HTTP) transport — LOOPBACK by default. A network bind needs a
# deliberate change AND a TLS-terminating reverse proxy in front (see docs).
OYSTER_MCP_HTTP_HOST=127.0.0.1
OYSTER_MCP_HTTP_PORT=8765

# HTTP auth. Either use Supabase-authenticated clients (recommended for
# org/individual use — no extra config), or set explicit static bearer tokens as
# comma-separated "token:email" pairs for local/machine use. Tokens must be long
# and random; production refuses weak/short ones. Leave empty to require Supabase.
# OYSTER_MCP_HTTP_TOKENS=REPLACE_WITH_LONG_RANDOM_TOKEN:you@example.com
# Browser Origin allow-list (DNS-rebinding defence). Empty = refuse any request
# carrying a browser Origin (native MCP clients send none). No wildcards.
# OYSTER_MCP_ALLOWED_ORIGINS=https://app.example.com

# Bounds
OYSTER_MCP_MAX_REQUEST_BYTES=262144
OYSTER_MCP_MAX_RESULT_BYTES=131072
OYSTER_MCP_RATE_LIMIT_PER_MIN=60
OYSTER_MCP_TOOL_TIMEOUT_S=30
OYSTER_MCP_MAX_SEARCH_TOP_K=20
