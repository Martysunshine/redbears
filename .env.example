# Red Bears — copy to .env and fill in. Placeholders only; never commit real values.
# Everything here is read SERVER-SIDE (backend / reranker). Nothing is exposed to the browser
# except NEXT_PUBLIC_API_URL.

# ── Where the big, non-git assets live (weights, indexes, venv) ───────────────
REDBEARS_ASSETS=$HOME/redbears-assets

# ── Ports ─────────────────────────────────────────────────────────────────────
REDBEARS_FRONTEND_PORT=3101
REDBEARS_BACKEND_PORT=8101
REDBEARS_RERANK_PORT=8110
NEXT_PUBLIC_API_URL=http://127.0.0.1:8101

# ── Oyster backend (see oyster/backend/.env.example for the full list) ────────
# Shared/demo/production: set OYSTER_DISABLE_AUTH=false AND OYSTER_PUBLIC_CHAT_ENABLED=false
# (verified: every route except /health and token-addressed share links then returns 401).
OYSTER_PUBLIC_CHAT_ENABLED=true
# Local dev only. Production REFUSES to boot with this true (config.py); use false + Supabase.
OYSTER_DISABLE_AUTH=true
# demo/production: 'production' + real values injected by the host secret manager
OYSTER_ENVIRONMENT=development
OYSTER_DEFAULT_MODEL=oyster-dolphin-v2
OYSTER_PUBLIC_CHAT_MODEL=dolphin3
OYSTER_OLLAMA_NUM_CTX=8192
OYSTER_EXECUTION_ENGINE_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Context window for the 27B Huihui model only (24 GB Mac: keep modest until measured)
OYSTER_HUIHUI_NUM_CTX=4096

# ── Nemotron reranker (nvidia/llama-nemotron-rerank-1b-v2) ───────────────────
NEMOTRON_RERANK_ENABLED=true
# Default: the local server in rerank_server/ speaking the NVIDIA NIM /v1/ranking schema.
# To use a NIM (self-hosted or hosted) instead, set its /v1/ranking URL and NVIDIA_API_KEY.
NEMOTRON_RERANK_URL=http://127.0.0.1:8110/v1/ranking
NEMOTRON_RERANK_MODEL=nvidia/llama-nemotron-rerank-1b-v2
NEMOTRON_RERANK_TIMEOUT_S=15
NEMOTRON_RERANK_CANDIDATES=16
# Cap on calls to a NON-local (possibly metered) rerank endpoint per UTC day, per process.
NEMOTRON_RERANK_DAILY_CALL_LIMIT=500
# Separate bearer for a private rerank endpoint (must equal RERANK_SERVER_TOKEN on the server).
NEMOTRON_RERANK_API_KEY=
RERANK_SERVER_TOKEN=
OYSTER_KNOWLEDGE_STREAM_RATE_PER_MIN=12
# Only needed for endpoints that require auth. If the URL host is *.nvidia.com and this
# is empty, reranking is skipped and the UI shows the fallback with this reason.
# Server-side only; sent ONLY to *.nvidia.com hosts. Leave empty for the local reranker.
NVIDIA_API_KEY=

# Local reranker server (rerank_server/server.py)
RERANK_MODEL_REVISION=828765652b05bd439c9789d2a6d093db1caa1443
RERANK_MAX_LENGTH=512
# RERANK_DEVICE=mps   # mps | cpu (auto-detected)

# ── Investigation workflow integrations — all optional; see docs/INVESTIGATION.md ──
# Nemotron REASONING (generative; NOT the reranker above), via NVIDIA/Nebius Token Factory.
NEBIUS_TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_API_KEY=
# Must be read from this account's own GET /models list (via the integration's "Test
# connection"), never guessed — left empty until you've confirmed one.
NEMOTRON_REASONING_MODEL=

# Tavily — research, source extraction. Juice Shop walkthroughs are always excluded
# from search (TAVILY_EXCLUDE_DOMAINS below), independent of this key being set.
TAVILY_API_KEY=
TAVILY_EXCLUDE_DOMAINS=github.com/juice-shop,pwning-owasp-juice-shop.helmesjo.net,bkimminich.gitbooks.io,owasp-juice.shop

# Devin — investigates/proposes a fix for one VERIFIED finding. DEVIN_ALLOWED_REPOS is
# empty by default: no repository is touchable until you explicitly list it here, even
# with valid credentials. API v3 (cog_ key); legacy v1 apk_/apk_user_ keys are not used.
DEVIN_API_KEY=
DEVIN_ORG_ID=
DEVIN_ALLOWED_REPOS=

# OpenCVE — read-only CVE catalog for Security Intel's "Latest intelligence" feed.
# Its hosted API needs an organisation token (verified live: an unauthenticated
# request returns 401). Leave this empty and the feed automatically falls back to
# the public CISA KEV catalog instead — no self-hosting, no separate setup needed.
OPENCVE_API_TOKEN=

# ── Investigation lab (isolated, disposable Juice Shop) ──────────────────────
# Forced off at boot if sandbox-exec is unavailable or the isolation self-test fails —
# never falls back to running the lab process unsandboxed. See scripts/setup-lab.sh.
LAB_ENABLED=true
LAB_JUICE_SHOP_DIR=$HOME/redbears-assets/lab/juice-shop-src
LAB_MAX_INSTANCES=2
LAB_INSTANCE_TTL_S=1800
